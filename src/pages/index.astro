---
import { getCollection } from "astro:content";
import ShellLayout from "@layouts/ShellLayout.astro";
import WaitlistForm from "@components/WaitlistForm.astro";
import Scene from "@components/scene/Scene";

const featured = (await getCollection("proof"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<ShellLayout
  pageTitle="A. M. Madani — AI Solutions Architect"
  description="Privacy-first AI architecture for European enterprise. Creator of The Harvest Methodology."
  schema="home"
>
  <!-- Fixed, so the three tricks play out across the whole scroll rather than
       sliding off with the first screen. -->
  <div class="stage">
    <Scene client:load />
    <div class="poster" aria-hidden="true"></div>
  </div>

  <!-- ACT I ─ the reveal ────────────────────────────────────────────────── -->
  <section class="act act-1">
    <p class="eyebrow">// A. M. MADANI &mdash; AI SOLUTIONS ARCHITECT</p>
    <h1>The trick is repeatable.</h1>
    <p class="lead">
      A diamond is carbon that got the conditions right. So is an engineering
      organisation that ships. I build the conditions &mdash; privacy-first AI
      architecture for European enterprise.
    </p>
    <p class="links mono">
      <a href="#proof">Evidence</a>
      <a href="/dossier/">Dossier</a>
      <a href="mailto:amyrmahdy1@gmail.com">Talk</a>
    </p>
    <p class="cue mono" aria-hidden="true">SCROLL &mdash; WATCH</p>
  </section>

  <!-- ACT II ─ the divide ───────────────────────────────────────────────── -->
  <section class="act act-2" id="proof">
    <p class="eyebrow">// DONE, NOT CLAIMED</p>
    <ol class="beats">
      {
        featured.map((p) => (
          <li>
            <a href={`/proof/${p.id}/`}>
              <span class="n mono">{p.data.metrics[0].value}</span>
              <span class="l">{p.data.metrics[0].label}</span>
              <span class="c mono">{p.data.codename ?? p.data.org}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="more mono">
      <a href="/proof/">Nine systems, every number with its method &rarr;</a>
    </p>
  </section>

  <!-- ACT III ─ the vanish ──────────────────────────────────────────────── -->
  <section class="act act-3">
    <WaitlistForm
      placement="book"
      eyebrow="// THE HARVEST FIELD CARD"
      heading="The method on one page."
      blurb="The loop, the scoring sheet, the quality floor. Made to be pinned to a wall."
      button="Send the card"
    />
  </section>
</ShellLayout>

<style>
  .stage {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .stage :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  /* Holds the frame before the first paint, and permanently on the static
     tier, so the page is never blank and never obviously missing something. */
  .poster {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(30% 30% at 62% 44%, color-mix(in oklab, var(--ice) 13%, transparent), transparent 70%),
      radial-gradient(70% 50% at 50% 105%, color-mix(in oklab, var(--ember) 6%, transparent), transparent 70%);
    transition: opacity 1s var(--ease-mantle);
  }
  :global(html.gl-active) .poster { opacity: 0; }

  .act {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: grid;
    align-content: center;
    max-width: var(--w-wide);
    margin-inline: auto;
    padding: var(--gutter);
    padding-block: clamp(4rem, 12vh, 8rem);
  }

  /* Copy keeps to the left half so the stone owns the right of the frame. */
  .act-1 > * { max-width: 32rem; }

  h1 {
    font-size: var(--t-monument);
    margin-block: 1rem 1.5rem;
  }
  .lead { max-width: 34ch; color: var(--muted); }

  .links {
    display: flex;
    gap: 1.75rem;
    margin-top: 2.5rem;
    font-size: var(--t-small);
    letter-spacing: 0.08em;
  }
  .links a {
    color: var(--accent);
    border-bottom: 1px solid color-mix(in oklab, var(--accent) 32%, transparent);
    padding-bottom: 0.3rem;
  }
  .links a:hover { border-color: var(--accent); }

  .cue {
    margin-top: 4rem;
    font-size: var(--t-micro);
    letter-spacing: 0.34em;
    color: var(--muted);
    opacity: 0.55;
  }

  /* ── act II ─────────────────────────────────────────────────────────── */
  .beats {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    /* Sits over the canvas, so it needs its own ground. */
    backdrop-filter: blur(10px);
  }
  .beats a {
    display: block;
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    padding: 1.9rem 1.4rem;
    height: 100%;
    transition: background-color var(--dur-quick) var(--ease-facet);
  }
  .beats a:hover { background: var(--surface); color: inherit; }

  .n {
    display: block;
    font-size: var(--t-h2);
    font-weight: 500;
    color: var(--accent);
    line-height: 1;
  }
  .l {
    display: block;
    margin-top: 0.65rem;
    font-size: var(--t-small);
    line-height: 1.4;
  }
  .c {
    display: block;
    margin-top: 0.9rem;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .more { margin-top: 1.25rem; font-size: var(--t-micro); letter-spacing: 0.08em; }
  .more a { color: var(--muted); }
  .more a:hover { color: var(--accent); }

  /* ── act III ────────────────────────────────────────────────────────── */
  .act-3 { max-width: var(--w-text); }

  @media (max-width: 900px) {
    .act-1 { align-content: end; }
    .act-1 > * { max-width: none; }
    .lead { max-width: 40ch; }
    .cue { margin-top: 2.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster { opacity: 1 !important; }
  }
</style>

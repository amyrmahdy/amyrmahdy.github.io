---
import { getCollection } from "astro:content";
import ShellLayout from "@layouts/ShellLayout.astro";
import WaitlistForm from "@components/WaitlistForm.astro";
import Scene from "@components/scene/Scene";

const featured = (await getCollection("proof"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<ShellLayout
  pageTitle="A. M. Madani — AI Solutions Architect"
  description="Privacy-first AI architecture for European enterprise. Creator of The Harvest Methodology."
  schema="home"
>
  <!-- ── the stone ─────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="stage">
      <Scene client:load />
      <!-- Shown until the canvas paints, and permanently on the static tier. -->
      <div class="poster" aria-hidden="true"></div>
    </div>

    <div class="hero-copy">
      <p class="eyebrow">// A. M. MADANI</p>
      <h1>Same carbon.</h1>
      <p class="lead">
        Graphite and diamond are the same element. Pressure, structure and speed
        are the entire difference &mdash; in geology, and in what your engineering
        organisation produces.
      </p>
      <p class="hero-links mono">
        <a href="#proof">The evidence</a>
        <a href="/dossier/">Dossier</a>
        <a href="mailto:amyrmahdy1@gmail.com">Talk</a>
      </p>
    </div>

    <p class="scrim mono" aria-hidden="true">SCROLL</p>
  </section>

  <!-- ── three beats ───────────────────────────────────────────────────── -->
  <section class="beats" id="proof">
    <ol>
      {
        featured.map((p) => (
          <li>
            <a href={`/proof/${p.id}/`}>
              <span class="beat-n mono">{p.data.metrics[0].value}</span>
              <span class="beat-l">{p.data.metrics[0].label}</span>
              <span class="beat-c mono">
                {p.data.codename ?? p.data.title.slice(0, 40)}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="beats-more mono">
      <a href="/proof/">Nine systems, every number with its method &rarr;</a>
    </p>
  </section>

  <!-- ── one ask ───────────────────────────────────────────────────────── -->
  <section class="ask">
    <WaitlistForm
      placement="book"
      eyebrow="// THE HARVEST FIELD CARD"
      heading="The methodology on one page."
      blurb="The loop, the ICE sheet, the quality floor. One page, made to be pinned to a wall."
      button="Send the card"
    />
  </section>
</ShellLayout>

<style>
  /* ── hero ──────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-content: center;
    padding: var(--gutter);
    overflow: hidden;
  }

  .stage {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .stage :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  /* A quiet radial suggestion of the stone, so the first frame is never empty
     and the static tier still looks composed. */
  .poster {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(38% 38% at 58% 46%, color-mix(in oklab, var(--ice) 14%, transparent), transparent 70%),
      radial-gradient(60% 50% at 50% 100%, color-mix(in oklab, var(--ember) 7%, transparent), transparent 70%);
    transition: opacity 900ms var(--ease-mantle);
  }
  :global(html.gl-active) .poster { opacity: 0; }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    /* Sits left of the stone rather than on top of it. */
    margin-inline-end: auto;
  }

  h1 {
    font-size: var(--t-monument);
    margin-block: 0.75rem 1.25rem;
  }
  .lead { max-width: 30ch; }

  .hero-links {
    display: flex;
    gap: 1.75rem;
    margin-top: 2.25rem;
    font-size: var(--t-small);
    letter-spacing: 0.1em;
  }
  .hero-links a {
    color: var(--accent);
    border-bottom: 1px solid color-mix(in oklab, var(--accent) 35%, transparent);
    padding-bottom: 0.3rem;
  }
  .hero-links a:hover { border-color: var(--accent); }

  .scrim {
    position: absolute;
    left: var(--gutter);
    bottom: 1.75rem;
    z-index: 1;
    font-size: var(--t-micro);
    letter-spacing: 0.34em;
    color: var(--muted);
    opacity: 0.6;
  }

  /* ── beats ─────────────────────────────────────────────────────────── */
  .beats {
    max-width: var(--w-wide);
    margin-inline: auto;
    padding: clamp(4rem, 12vh, 7rem) var(--gutter);
  }
  .beats ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .beats a {
    display: block;
    background: var(--bg);
    padding: 2rem 1.5rem;
    height: 100%;
    transition: background-color var(--dur-quick) var(--ease-facet);
  }
  .beats a:hover { background: var(--surface); color: inherit; }

  .beat-n {
    display: block;
    font-size: var(--t-h2);
    font-weight: 500;
    color: var(--accent);
    line-height: 1;
  }
  .beat-l {
    display: block;
    margin-top: 0.7rem;
    font-size: var(--t-small);
    color: var(--fg);
    line-height: 1.4;
  }
  .beat-c {
    display: block;
    margin-top: 1rem;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .beats-more { margin-top: 1.5rem; font-size: var(--t-micro); letter-spacing: 0.1em; }
  .beats-more a { color: var(--muted); }
  .beats-more a:hover { color: var(--accent); }

  /* ── ask ───────────────────────────────────────────────────────────── */
  .ask {
    max-width: var(--w-text);
    margin-inline: auto;
    padding: 0 var(--gutter) clamp(5rem, 14vh, 8rem);
  }

  @media (max-width: 900px) {
    .hero { align-content: end; padding-bottom: 5rem; }
    .hero-copy { max-width: none; }
    .lead { max-width: 40ch; }
  }
</style>

---
/**
 * Most kimberlite pipes come up empty — the geology carries the joke, so the
 * 404 stays in voice without straining for one.
 */
import ShellLayout from "@layouts/ShellLayout.astro";
---

<ShellLayout
  pageTitle="404 — No sample at this depth"
  description="This route came up empty."
>
  <section class="chapter">
    <p class="eyebrow">// 404 &middot; NO SAMPLE AT THIS DEPTH</p>
    <h1 class="chapter-title">Barren pipe.</h1>
    <p class="lead">
      Most kimberlite pipes come up empty. This one has nothing in it &mdash;
      everything worth having is back at the surface.
    </p>
    <p class="cta-row">
      <a class="cta" href="/">Return to 0 km &rarr;</a>
    </p>
  </section>
</ShellLayout>

<style>
  .chapter { min-height: 70svh; align-content: center; }
  .chapter-title { margin-block: 1.25rem 1.5rem; }
  .cta-row { margin-top: 2.5rem; }
  .cta {
    font-family: var(--font-mono);
    font-size: var(--t-small);
    letter-spacing: 0.1em;
    color: var(--accent);
    border-bottom: 1px solid color-mix(in oklab, var(--accent) 40%, transparent);
    padding-bottom: 0.35rem;
  }
  .cta:hover { border-color: var(--accent); }
</style>

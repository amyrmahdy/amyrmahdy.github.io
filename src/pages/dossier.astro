---
/**
 * The antidote to the biggest risk in the whole design.
 *
 * A narrative scroll is a seduction device: it works on one person, in one
 * sitting, on a large screen. It does not survive procurement, or being
 * forwarded to a CFO, or "send me something". This page is the entire argument
 * flat, undecorated, motion-free, readable in sixty seconds, and it prints.
 */
import { getCollection } from "astro:content";
import ShellLayout from "@layouts/ShellLayout.astro";
import { CAREER, EDUCATION, HARVEST_LOOP, HARVEST_PILLARS } from "@lib/career";

const proof = (await getCollection("proof")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<ShellLayout
  pageTitle="Dossier — A. M. Madani, AI Solutions Architect"
  description="The whole argument on one page: nine delivered systems with real numbers and how each was measured, the chronology, and The Harvest Methodology."
>
  <article class="dossier">
    <header>
      <p class="eyebrow">// DOSSIER</p>
      <h1>A. M. Madani</h1>
      <p class="sub mono">
        AI Solutions Architect &middot; CTO, Smartway Solutions &middot; Germany
        &middot; EU
      </p>
      <p class="thesis">
        I audit broken enterprise processes and rewire them with privacy-first
        AI agentic architectures &mdash; then build the teams that ship them.
        Creator of <strong>The Harvest Methodology</strong>, an operating model
        that turns fast execution into compounding, reusable advantage.
      </p>
      <p class="mono links">
        <a href="/">The long version &rarr;</a>
        <a href="/proof/">Proof index &rarr;</a>
        <a href="mailto:amyrmahdy1@gmail.com">amyrmahdy1@gmail.com</a>
      </p>
    </header>

    <section>
      <h2>Evidence</h2>
      <p class="note">
        Every row is a delivered system, its number, and how that number was
        measured. Each is individually linkable.
      </p>

      <table>
        <thead>
          <tr>
            <th scope="col">System</th>
            <th scope="col">Result</th>
            <th scope="col">Where</th>
          </tr>
        </thead>
        <tbody>
          {
            proof.map((p) => (
              <tr id={p.id}>
                <td>
                  <a href={`/proof/${p.id}/`}>
                    {p.data.codename ?? p.data.title}
                  </a>
                  {p.data.codename && <span class="row-sub">{p.data.title}</span>}
                </td>
                <td class="mono nums">
                  {p.data.metrics.map((m) => (
                    <span class="num">
                      <strong>{m.value}</strong> {m.label}
                    </span>
                  ))}
                </td>
                <td class="mono where">
                  {p.data.org}
                  <br />
                  {p.data.period}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section>
      <h2>The Harvest Methodology</h2>
      <p class="mono loop">
        {HARVEST_LOOP.join("  →  ")}
      </p>
      <dl class="pillars">
        {
          HARVEST_PILLARS.map((p) => (
            <div>
              <dt>{p.name}</dt>
              <dd>{p.statement}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section>
      <h2>Chronology</h2>
      <dl class="chrono">
        {
          CAREER.map((c) => (
            <div>
              <dt class="mono">{c.period}</dt>
              <dd>
                <strong>{c.role}</strong>
                <span class="row-sub">
                  {c.org} &middot; {c.place}
                </span>
              </dd>
            </div>
          ))
        }
        {
          EDUCATION.map((e) => (
            <div>
              <dt class="mono">{e.period}</dt>
              <dd>
                <strong>{e.award}</strong>
                <span class="row-sub">
                  {e.org} &middot; {e.place}
                  {e.note ? ` · ${e.note}` : ""}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <footer>
      <p class="mono">
        amyrmahdy1@gmail.com &middot; github.com/amyrmahdy &middot;
        amyrmahdy.medium.com
      </p>
    </footer>
  </article>
</ShellLayout>

<style>
  .dossier {
    max-width: var(--w-wide);
    margin-inline: auto;
    padding: clamp(3rem, 8vh, 6rem) var(--gutter);
  }

  h1 {
    font-size: var(--t-h2);
    margin-block: 1rem 0.75rem;
  }
  .sub {
    font-size: var(--t-micro);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .thesis {
    margin-top: 1.5rem;
    max-width: 68ch;
    font-size: var(--t-lead);
    line-height: var(--lh-lead);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.75rem;
    font-size: var(--t-small);
  }
  .links a {
    color: var(--accent);
    border-bottom: 1px solid var(--line);
  }

  section {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: var(--t-h3);
    margin-bottom: 0.5rem;
  }
  .note {
    color: var(--muted);
    font-size: var(--t-small);
    max-width: 68ch;
    margin-bottom: 1.5rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-small);
  }
  th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  td {
    vertical-align: top;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
    padding-right: 1.5rem;
  }
  td a { color: var(--fg); border-bottom: 1px solid var(--line); }
  td a:hover { color: var(--accent); }

  .row-sub {
    display: block;
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: var(--t-micro);
    line-height: 1.5;
    font-weight: 400;
  }

  .nums { min-width: 16rem; }
  .num { display: block; font-size: var(--t-micro); color: var(--muted); line-height: 1.7; }
  .num strong { color: var(--accent); font-weight: 500; }
  .where { white-space: nowrap; font-size: var(--t-micro); color: var(--muted); }

  .loop {
    font-size: var(--t-small);
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .pillars, .chrono { display: grid; gap: 1.25rem; margin: 0; }
  .pillars div, .chrono div {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) 1fr;
    gap: 1.5rem;
  }
  dt { font-weight: 600; color: var(--fg); }
  .chrono dt { color: var(--muted); font-size: var(--t-micro); padding-top: 0.2rem; }
  dd { margin: 0; color: var(--muted); font-size: var(--t-small); line-height: 1.6; }
  dd strong { color: var(--fg); font-weight: 600; }

  footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--t-micro);
    color: var(--muted);
    letter-spacing: 0.1em;
  }

  @media (max-width: 640px) {
    .pillars div, .chrono div { grid-template-columns: 1fr; gap: 0.35rem; }
    td { padding-right: 0.75rem; }
    .nums { min-width: 0; }
    .where { white-space: normal; }
  }

  /* Prints as a clean two-page PDF on white. This is the version that gets
     attached to an email, so it cannot depend on a dark background. */
  @media print {
    :global(html) {
      --bg: #fff;
      --surface: #fff;
      --fg: #111;
      --muted: #444;
      --line: #bbb;
      --accent: #111;
    }
    :global(.skip-link) { display: none; }
    .dossier { padding: 0; max-width: none; }
    .links { display: none; }
    section { break-inside: auto; }
    tr, .pillars div, .chrono div { break-inside: avoid; }
    td a { border: 0; }
    td a::after {
      content: " (" attr(href) ")";
      font-size: 0.75em;
      color: #666;
    }
  }
</style>

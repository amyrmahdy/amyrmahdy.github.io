---
/**
 * A chapter's hard artifact, in the wide column. Every chapter carries at least
 * one; a chapter with no number is decoration and gets cut.
 */
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"proof">[];
}

const { entries } = Astro.props;
---

<ul class="artifacts">
  {
    entries.map((p) => (
      <li>
        <a href={`/proof/${p.id}/`}>
          <span class="a-name mono">
            {p.data.codename ?? p.data.org}
            <span class="a-arrow" aria-hidden="true">
              &rarr;
            </span>
          </span>
          <span class="a-title">{p.data.title}</span>
          <span class="a-metrics mono">
            {p.data.metrics.map((m) => (
              <span>
                <strong>{m.value}</strong> {m.label}
              </span>
            ))}
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .artifacts {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .artifacts a {
    display: block;
    background: var(--bg);
    padding: 1.35rem 1.25rem;
    transition: background-color var(--dur-quick) var(--ease-facet);
  }
  .artifacts a:hover { background: var(--surface); color: inherit; }

  .a-name {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .artifacts a:hover .a-arrow { color: var(--accent); }

  .a-title {
    display: block;
    margin-top: 0.6rem;
    font-size: var(--t-body);
    line-height: 1.4;
    max-width: 52ch;
  }

  .a-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.85rem;
    font-size: var(--t-micro);
    color: var(--muted);
  }
  .a-metrics strong { color: var(--accent); font-weight: 500; }
</style>

---
/**
 * Structured data.
 *
 * Only claims that are independently checkable go in here: a name, a role, an
 * employer, two profiles. Structured data is machine-readable assertion, so
 * anything unverified must not appear.
 *
 * Note: no LinkedIn in sameAs. That is a deliberate brand constraint, not an
 * oversight — do not "helpfully" add it.
 */
interface Props {
  type?: "home" | "page";
}

const { type = "page" } = Astro.props;
const site = Astro.site?.origin ?? "https://amyrmahdy.github.io";

const person = {
  "@type": "Person",
  "@id": `${site}/#person`,
  name: "Amir Mahdi Madani",
  alternateName: "A. M. Madani",
  jobTitle: "AI Solutions Architect",
  description:
    "AI Solutions Architect and CTO. Designs privacy-first AI agentic architectures for European enterprise. Creator of The Harvest Methodology.",
  url: `${site}/`,
  email: "mailto:amyrmahdy1@gmail.com",
  worksFor: {
    "@type": "Organization",
    name: "Smartway Solutions",
    address: { "@type": "PostalAddress", addressCountry: "DE" },
  },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Astrakhan State University" },
    {
      "@type": "CollegeOrUniversity",
      name: "Mahalat Higher Educational Institution",
    },
  ],
  knowsAbout: [
    "AI Solutions Architecture",
    "Multi-Agent Systems",
    "Retrieval-Augmented Generation",
    "LLM Evaluation",
    "Privacy-First AI",
    "The Harvest Methodology",
    "Forward Deployed Engineering",
  ],
  sameAs: ["https://github.com/amyrmahdy", "https://amyrmahdy.medium.com"],
};


const graph =
  type === "home"
    ? [
        person,
        {
          "@type": "ProfilePage",
          "@id": `${site}/#profile`,
          mainEntity: { "@id": `${site}/#person` },
          url: `${site}/`,
        },
      ]
    : [person];

const jsonld = { "@context": "https://schema.org", "@graph": graph };
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(jsonld)}
/>
